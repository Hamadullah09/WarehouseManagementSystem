<?xml version="1.0" encoding="utf-8"?><!--
  The gate sheet, laid out as the printed form: document number and the two
  totals across the top, the user and the movement beside them, the
  outstanding rolls down the left, and the two balance figures boxed on the
  right in red.

  Sized for the U300's panel, which is 1280x720 at 240dpi and therefore only
  853 x 480 dp of usable space, a good deal less than the pixel count
  suggests. Every dimension below is chosen against that budget, and the two
  balance figures auto-size so they fill their box on a larger screen without
  overflowing this one.

  Status and errors share one band under the sheet: what the reader is doing,
  the tag it last saw, and, when something is wrong, the problem in its place.
  A separate alarm card covered the balance figures, which are the one thing
  that must never be hidden.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- The sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_sheet"
            android:padding="8dp">

            <!-- Row 1: document number, then the two totals -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_document"
                    style="@style/Sheet.Label" />

                <TextView
                    android:id="@+id/document_number"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="10dp"
                    style="@style/Sheet.Value" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_total_articles"
                    style="@style/Sheet.Label" />

                <TextView
                    android:id="@+id/total_articles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="10dp"
                    style="@style/Sheet.Value" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_total_qty"
                    style="@style/Sheet.Label" />

                <TextView
                    android:id="@+id/total_quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    style="@style/Sheet.Value" />
            </LinearLayout>

            <!-- Row 2: user, and the movement in red -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_user"
                    style="@style/Sheet.Label" />

                <TextView
                    android:id="@+id/user_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="start"
                    style="@style/Sheet.Value" />

                <TextView
                    android:id="@+id/movement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/figure"
                    android:gravity="center"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Body: the outstanding rolls, and the two figures -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.25"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sheet_balance_articles"
                        style="@style/Sheet.Heading" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rolls"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="3dp"
                        android:scrollbars="vertical"
                        android:clipToPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_totals"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sheet_balance_articles"
                        style="@style/Sheet.Heading" />

                    <TextView
                        android:id="@+id/balance_articles"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.5"
                        android:textColor="@color/figure"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="28sp"
                        android:autoSizeMaxTextSize="96sp"
                        android:autoSizeStepGranularity="1sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sheet_balance_qty"
                        style="@style/Sheet.Heading" />

                    <TextView
                        android:id="@+id/balance_quantity"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/figure"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="20sp"
                        android:autoSizeMaxTextSize="52sp"
                        android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- What the reader is doing, and the tag it last saw -->
            <LinearLayout
                android:id="@+id/status_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="5dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@color/info_soft">

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/info" />

                <TextView
                    android:id="@+id/last_epc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/ink"
                    android:maxLines="1"
                    android:ellipsize="middle" />
            </LinearLayout>
        </LinearLayout>

        <!--
          Controls. Green go, red stop, grey back, and a reset that is only
          there when something has latched: an alarm this gate raises does not
          time out, because the roll that caused it has to be taken off the
          pallet by hand and somebody has to say they have done it.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                style="@style/Sheet.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="@string/back"
                app:backgroundTint="@color/button_back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start"
                style="@style/Sheet.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.6"
                android:layout_marginStart="6dp"
                android:text="@string/start"
                app:backgroundTint="@color/button_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop"
                style="@style/Sheet.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.6"
                android:layout_marginStart="6dp"
                android:text="@string/stop"
                android:visibility="gone"
                app:backgroundTint="@color/button_stop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset"
                style="@style/Sheet.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="2"
                android:layout_marginStart="6dp"
                android:text="@string/reset"
                android:visibility="gone"
                app:backgroundTint="@color/reset" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

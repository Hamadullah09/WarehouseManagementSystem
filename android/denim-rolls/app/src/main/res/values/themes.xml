<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DenimRolls" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/info</item>
        <item name="colorError">@color/alarm</item>
        <item name="android:colorBackground">@color/surface_alt</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- The scan screen is a wall display: dark ground, large numerals. -->
    <style name="Theme.DenimRolls.Scan" parent="Theme.DenimRolls">
        <item name="android:colorBackground">@color/scan_bg</item>
        <item name="colorSurface">@color/scan_surface</item>
        <item name="colorOnSurface">@color/scan_text</item>
        <item name="android:statusBarColor">@color/scan_bg</item>
    </style>

    <style name="Metric.Label" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/scan_muted</item>
    </style>

    <style name="Metric.Value" parent="">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/scan_text</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- One theme, light. No dark variant: a warehouse panel that changes
         appearance with a system setting is a support call waiting to happen. -->
    <style name="Theme.DenimRolls" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/info</item>
        <item name="colorError">@color/alarm</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/line_soft</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>

    <!-- The gate sheet uses the same light theme; it differs only in layout. -->
    <style name="Theme.DenimRolls.Scan" parent="Theme.DenimRolls" />

    <!-- Header label above a boxed value, as on the printed form. -->
    <style name="Sheet.Label" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Boxed value: blue outline, black text, large. -->
    <style name="Sheet.Value" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">90dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Section heading, e.g. BALANCE ARTICLES. -->
    <style name="Sheet.Heading" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Every button is filled and coloured; nothing important is a grey outline. -->
    <style name="Sheet.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">60dp</item>
    </style>
</resources>

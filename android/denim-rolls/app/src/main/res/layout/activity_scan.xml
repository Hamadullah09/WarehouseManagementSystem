<?xml version="1.0" encoding="utf-8"?><!--
  The gate panel. Dark ground, oversized numerals: read from across a bay,
  not from a desk. The two balance figures are the last thing allowed to
  shrink, because they are what the operator actually watches.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/scan_bg">

    <!-- Header: who, what, which way -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/scan_surface"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_document"
                style="@style/Metric.Label" />

            <TextView
                android:id="@+id/document_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/scan_text"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/scan_muted"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/movement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="#FFFFFF"
            android:background="@color/ok" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/close"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Totals -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_total_articles"
                style="@style/Metric.Label" />

            <TextView
                android:id="@+id/total_articles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Metric.Value" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_total_qty"
                style="@style/Metric.Label" />

            <TextView
                android:id="@+id/total_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Metric.Value" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_balance_articles"
                style="@style/Metric.Label" />

            <TextView
                android:id="@+id/balance_articles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Metric.Value"
                android:textSize="44sp"
                android:textColor="@color/brand" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_balance_qty"
                style="@style/Metric.Label" />

            <TextView
                android:id="@+id/balance_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Metric.Value"
                android:textSize="44sp"
                android:textColor="@color/brand" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status band -->
    <LinearLayout
        android:id="@+id/status_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="@color/scan_surface">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/last_epc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#DDFFFFFF" />
    </LinearLayout>

    <!-- Alarm banner -->
    <LinearLayout
        android:id="@+id/alarm_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:padding="14dp"
        android:background="@color/alarm"
        android:visibility="gone">

        <TextView
            android:id="@+id/alarm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/alarm_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:text="@string/scan_rolls"
        style="@style/Metric.Label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rolls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false" />

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="@color/scan_surface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/start"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:enabled="false"
            app:backgroundTint="@color/ok"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/stop"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:visibility="gone"
            app:backgroundTint="@color/alarm"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?><!--
  The gate sheet, laid out as the printed form the warehouse already uses:
  document number, totals and user across the top, the movement in red beside
  them, the outstanding rolls listed down the left, and the two figures that
  matter boxed on the right.

  Light, black on white, large type. Read by people of every age from a metre
  or two away, so nothing here is subtle: every button is filled and coloured,
  and no state is signalled by shade alone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sheet_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:gravity="center"
        android:paddingBottom="6dp" />

    <!-- The sheet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet"
        android:padding="10dp">

        <!-- Row 1: document number and the two totals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_document"
                style="@style/Sheet.Label" />

            <TextView
                android:id="@+id/document_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="14dp"
                style="@style/Sheet.Value" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_total_articles"
                style="@style/Sheet.Label" />

            <TextView
                android:id="@+id/total_articles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="14dp"
                android:minWidth="70dp"
                style="@style/Sheet.Value" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_total_qty"
                style="@style/Sheet.Label" />

            <TextView
                android:id="@+id/total_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="70dp"
                style="@style/Sheet.Value" />
        </LinearLayout>

        <!-- Row 2: user, and the movement in red -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_user"
                style="@style/Sheet.Label" />

            <TextView
                android:id="@+id/user_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="14dp"
                android:gravity="start"
                style="@style/Sheet.Value" />

            <TextView
                android:id="@+id/movement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="@color/figure"
                android:gravity="center"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Body: the list, and the two figures -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_balance_articles"
                    style="@style/Sheet.Heading" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rolls"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:scrollbars="vertical"
                    android:clipToPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_totals"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_balance_articles"
                    style="@style/Sheet.Heading" />

                <TextView
                    android:id="@+id/balance_articles"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:textSize="96sp"
                    android:textStyle="bold"
                    android:textColor="@color/figure"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="40sp"
                    android:autoSizeMaxTextSize="110sp"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_balance_qty"
                    style="@style/Sheet.Heading" />

                <TextView
                    android:id="@+id/balance_quantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="@color/figure"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- What the reader is doing, in words -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@color/info_soft"
            android:textColor="@color/info" />

        <!-- The tag just read, and any problem with it -->
        <TextView
            android:id="@+id/last_epc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/ink_muted"
            android:maxLines="1"
            android:ellipsize="middle" />

        <LinearLayout
            android:id="@+id/alarm_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:padding="10dp"
            android:background="@color/alarm"
            android:visibility="gone">

            <TextView
                android:id="@+id/alarm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/alarm_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Controls. Filled and coloured: green go, red stop, grey back. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Sheet.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/back"
            app:backgroundTint="@color/button_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start"
            style="@style/Sheet.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:layout_marginStart="8dp"
            android:text="@string/start"
            app:backgroundTint="@color/button_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stop"
            style="@style/Sheet.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:layout_marginStart="8dp"
            android:text="@string/stop"
            android:visibility="gone"
            app:backgroundTint="@color/button_stop" />
    </LinearLayout>
</LinearLayout>

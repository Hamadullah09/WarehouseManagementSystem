{
  "ConnectionStrings": {
    "Warehouse": "Server=(localdb)\\MSSQLLocalDB;Database=WarehouseGate;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  "Database": {
    "MigrateOnStartup": true
  },

  "Jwt": {
    "Issuer": "warehouse-gate",
    "Audience": "warehouse-gate",
    "SigningKey": "",
    "LifetimeMinutes": 60
  },

  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },

  "Gate": {
    "CycleTimeoutMs": 60000,
    "DrainMs": 750,
    "MinimumCycleIntervalMs": 500,
    "AutoRearmAfterPass": true,
    "AutoRearmAfterAlarm": false,
    "BlockCycleWhenReaderOffline": true,
    "RequireAllExpected": true,
    "FailOnUnknownEpc": true,
    "FailOnUnexpectedEpc": true,
    "FailOnEmptyRead": true,
    "RequireHealthyReader": true,
    "MaxEpcsPerCycle": 0
  },

  "Documents": {
    "MaxEpcsPerDocument": 30,
    "NumberPadding": 6,
    "InwardPrefix": "IN",
    "OutwardPrefix": "OUT",
    "CyclePrefix": "GC",
    "AlarmPrefix": "AL",
    "MaxRetries": 5
  },

  "Alarms": {
    "DriveGpioOutput": true,
    "RequireSupervisorToResolve": true
  },

  "Rfid": {
    "AllowSimulation": false,
    "Readers": [
      {
        "ReaderId": "U300-01",
        "Name": "Main gate reader",
        "GateId": "GATE-01",
        "Driver": "U300",

        "BridgeHost": "127.0.0.1",
        "BridgePort": 9310,

        "ReaderHost": "192.168.1.100",
        "ReaderPort": 9160,

        "Antennas": [ 1 ],
        "AntennaPowerDbm": { "1": 30 },

        "TriggerMode": "Command",

        "Gpio": {
          "GateSignalInput": "Gpi1",
          "GateSignalActiveHigh": true,
          "AlarmOutput": "Gpo1",
          "PassOutput": "Gpo2",
          "AlarmPulseMs": 3000,
          "PassPulseMs": 1500,
          "DebounceMs": 150
        },

        "ReconnectMinSeconds": 5,
        "ReconnectMaxSeconds": 120,
        "CommandTimeoutMs": 10000,
        "HeartbeatTimeoutSeconds": 30,
        "Enabled": true
      }
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Warehouse.Application.Gates": "Information",
        "Warehouse.Rfid": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/warehouse-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}

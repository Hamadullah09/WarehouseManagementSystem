<?xml version="1.0" encoding="utf-8"?>
<!-- Panel surface: a hairline border rather than a heavy block, so the eye
     goes to the numbers and not to the containers. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/scan_surface" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="@color/scan_line" />
</shape>
